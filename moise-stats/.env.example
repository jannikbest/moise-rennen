# Fernet key for the encrypted stats DB (auto-generated on first run if empty)
MOISE_STATS_KEY=

# ESP WebSocket — auto = UDP discover on LAN; or set a preferred URL/IP
# Examples:
#   ESP_WS_URL=auto                         # UDP broadcast MOISE? → first reply
#   ESP_WS_URL=ws://127.0.0.1:81/          # local mock (dev.sh sets this)
#   ESP_WS_URL=192.168.1.42                # preferred IP (falls back to discovery)
#   ESP_WS_URL=ws://moise-rennen.local:81/
ESP_WS_URL=auto

# Kino-facing WebSocket bind
KINO_WS_HOST=0.0.0.0
KINO_WS_PORT=8770

# Default mouse labels (lane id -> name)
LANE_LABELS=1:Speedy,2:Pilzy,3:Emdy,4:Kety,5:Koky

# Winner claim window after a race (seconds; resets on typing)
CLAIM_WINDOW_S=20

# Mock ESP manual start (dev only — leave empty / omit in production)
MOCK_CONTROL_URL=
