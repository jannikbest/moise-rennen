# Fernet key for the encrypted stats DB (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
MOISE_STATS_KEY=

# ESP WebSocket — full URL or bare IP/host (port 81 default)
# Examples:
#   ESP_WS_URL=ws://127.0.0.1:81/          # local mock
#   ESP_WS_URL=192.168.4.1                # SoftAP
#   ESP_WS_URL=192.168.1.42:81            # LAN IP
#   ESP_WS_URL=ws://moise-rennen.local:81/
ESP_WS_URL=ws://127.0.0.1:81/

# Kino-facing WebSocket bind
KINO_WS_HOST=0.0.0.0
KINO_WS_PORT=8770

# Default mouse labels (lane id -> name)
LANE_LABELS=1:Speedy,2:Pilzy,3:Emdy,4:Kety,5:Koky

# Winner claim window after a race (seconds; resets on typing)
CLAIM_WINDOW_S=20

# Mock ESP manual start (dev only — leave empty / omit in production)
MOCK_CONTROL_URL=http://127.0.0.1:82/go
